NODE_ENV=development
PORT=5000
# Dedicated LOCAL database only; never put an Atlas/production URI in demo/test commands.
MONGODB_URI=mongodb://127.0.0.1:27017/oasis_local
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRE=7d
# stream renders email in memory without delivery. Set smtp only after deliberate configuration.
EMAIL_MODE=stream
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=demo@example.test
SMTP_PASS=

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_SAME_SITE=lax
