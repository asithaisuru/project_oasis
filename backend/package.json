{
  "name": "oasis-tuition-backend",
  "version": "1.0.0",
  "description": "Backend for Oasis Tuition Classes Admin System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node utils/seedData.js",
    "seed:reset": "node utils/seedRobust.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
